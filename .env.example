# Example environment configuration for termchat
# Copy to .env.local and customize

# Server Configuration
TERMCHAT_ENV=development
TERMCHAT_ADDR=:8080

# Session Configuration
# Generate with: openssl rand -hex 32
TERMCHAT_SESSION_KEY=
TERMCHAT_SESSION_TTL=30m

# Retention Configuration
TERMCHAT_MESSAGES_PER_CHANNEL=200
TERMCHAT_MESSAGE_TTL=1h
TERMCHAT_SWEEP_INTERVAL=1m

# Rate Limiting
TERMCHAT_SEND_BURST=10
TERMCHAT_SEND_REFILL=2s
TERMCHAT_SEND_IDLE=5m

# Content Limits
TERMCHAT_BODY_MAX_LEN=2000
TERMCHAT_NICK_MAX_LEN=24
TERMCHAT_CHANNEL_NAME_MAX_LEN=32

# Network Configuration
TERMCHAT_TYPING_TTL=5s
TERMCHAT_KEEPALIVE=20s
TERMCHAT_EVENT_BUFFER=64

# CORS Configuration (comma-separated origins, no wildcards in production)
TERMCHAT_CORS_ORIGINS=

# Shutdown
TERMCHAT_SHUTDOWN_GRACE=10s
